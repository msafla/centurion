{
  "name": "centurion",
  "version": "0.1.0",
  "private": true,
  "description": "Local single-user annual control tracking application (MVP)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:demo": "tsx scripts/dev.ts --demo",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild src/server/index.ts src/mcp/server.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --target=node24 --sourcemap --outdir=dist",
    "start": "node dist/server/index.js",
    "mcp": "node dist/mcp/server.js",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && vitest run tests/unit tests/integration tests/security tests/mcp",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "smoke": "vitest run tests/integration/dependency-smoke.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@modelcontextprotocol/server-legacy": "2.3.0",
    "@takumi-rs/helpers": "2.14.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "lucide-react": "1.50.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "takumi-pdf": "0.15.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unpdf": "1.8.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
